#!/usr/bin/env python3
"""Command-line launcher for Celltaminate."""

from __future__ import annotations

import argparse
import csv
import json
import os
import shlex
import subprocess
import sys
import urllib.request
from pathlib import Path

VERSION = "0.2.0"
REFERENCE_DOI = "10.5281/zenodo.20560460"
REFERENCE_URL = "https://zenodo.org/records/20560460/files/refined_cell.lines.tsv?download=1"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def bool_text(x: bool) -> str:
    return "TRUE" if x else "FALSE"


def require_file(path: str, label: str) -> Path:
    p = Path(path).expanduser().resolve()
    if not p.is_file():
        raise SystemExit(f"ERROR: {label} not found: {p}")
    return p


def optional_file(path: str | None, label: str) -> Path | None:
    return require_file(path, label) if path else None


def add_bool(parser: argparse.ArgumentParser, name: str, default: bool) -> None:
    dest = name.lstrip("-").replace("-", "_")
    group = parser.add_mutually_exclusive_group()
    group.add_argument(name, dest=dest, action="store_true")
    group.add_argument("--no-" + name.lstrip("-"), dest=dest, action="store_false")
    parser.set_defaults(**{dest: default})


def read_input_list(path: Path) -> list[Path]:
    reports = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        p = Path(line).expanduser()
        p = (path.parent / p).resolve() if not p.is_absolute() else p.resolve()
        reports.append(require_file(str(p), "Kraken/KrakenUniq report"))
    return reports


def bundled(path: str) -> Path | None:
    p = repo_root() / path
    return p if p.is_file() else None


def validate_metadata(path: Path | None, report_names: set[str]) -> None:
    if path is None:
        return
    required = {"sample", "group", "sample_type"}
    with path.open("r", encoding="utf-8-sig", newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        fields = set(reader.fieldnames or [])
        missing = required - fields
        if missing:
            raise SystemExit("ERROR: metadata is missing columns: " + ", ".join(sorted(missing)))
        samples = {row["sample"].strip() for row in reader if row.get("sample", "").strip()}
    unmatched = sorted(samples - report_names)
    if unmatched:
        sys.stderr.write("WARNING: metadata sample names not matching report basenames:\n")
        sys.stderr.write("\n".join(f"  - {x}" for x in unmatched) + "\n")


def write_input_list(outdir: Path, reports: list[Path]) -> Path:
    cfg = outdir / "run_config"
    cfg.mkdir(parents=True, exist_ok=True)
    path = cfg / "input_list.absolute.txt"
    path.write_text("".join(str(p) + "\n" for p in reports), encoding="utf-8")
    return path


def run_cmd(cmd: list[str], dry_run: bool) -> int:
    print("Running command:")
    print(" ".join(shlex.quote(str(x)) for x in cmd))
    return 0 if dry_run else subprocess.call(cmd)


def command_run(args: argparse.Namespace) -> int:
    reports: list[Path] = []
    if args.reports:
        reports.extend(require_file(x, "Kraken/KrakenUniq report") for x in args.reports)
    if args.input_list:
        reports.extend(read_input_list(require_file(args.input_list, "input list")))
    reports = list(dict.fromkeys(p.resolve() for p in reports))
    if not reports:
        raise SystemExit("ERROR: provide reports with --reports or --input-list")

    outdir = Path(args.outdir).expanduser().resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    metadata = optional_file(args.metadata, "metadata TSV")
    protected = optional_file(args.protected_taxa_tsv, "protected taxa TSV")
    reference = optional_file(args.ref_bg_tsv, "reference background TSV") if args.ref_bg_tsv else bundled("data/reference/refined_cell.lines.tsv")
    kitome = optional_file(args.kitome_blacklist_tsv, "kitome/background TSV") if args.kitome_blacklist_tsv else bundled("data/panels/kitome_and_background_blacklist.tsv")
    clinical = optional_file(args.clinical_panel_tsv, "clinical-pathogen TSV") if args.clinical_panel_tsv else bundled("data/panels/clinically_important_pathogens.tsv")

    if reference is None:
        sys.stderr.write("WARNING: reference background table not found. Run `celltaminate download-reference` for the full workflow.\n")

    validate_metadata(metadata, {p.name for p in reports})
    input_list = write_input_list(outdir, reports)
    script = repo_root() / "scripts" / "Celltaminate.R"

    cmd = [
        args.rscript, "--vanilla", str(script),
        "--input_list", str(input_list),
        "--output_dir", str(outdir),
        "--tax_level", args.tax_level,
        "--host_species", args.host_species,
        "--include_protozoa", bool_text(args.include_protozoa),
        "--collapse_species", bool_text(args.collapse_species),
        "--collapse_min_genus_reads", str(args.collapse_min_genus_reads),
        "--collapse_top_frac", str(args.collapse_top_frac),
        "--fp_true_cutoff", str(args.fp_true_cutoff),
        "--keep_descendants", bool_text(args.keep_descendants),
        "--show_fp_breakdown", bool_text(args.show_fp_breakdown),
        "--save_cleaned_reanalysis", bool_text(args.save_cleaned_reanalysis),
    ]
    if args.host_taxids_manual:
        cmd += ["--host_taxids_manual", args.host_taxids_manual]
    for flag, value in [
        ("--metadata_tsv", metadata),
        ("--ref_bg_tsv", reference),
        ("--kitome_blacklist_tsv", kitome),
        ("--clinical_panel_tsv", clinical),
        ("--protected_taxa_tsv", protected),
    ]:
        if value is not None:
            cmd += [flag, str(value)]
    return run_cmd(cmd, args.dry_run)


def command_app(args: argparse.Namespace) -> int:
    script = repo_root() / "app" / "Celltaminate_app.R"
    return run_cmd([args.rscript, "--vanilla", str(script)], args.dry_run)


def command_init(args: argparse.Namespace) -> int:
    outdir = Path(args.outdir).expanduser().resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    (outdir / "input_list.txt").write_text("sample1.kraken.report.txt\n", encoding="utf-8")
    (outdir / "metadata.tsv").write_text(
        "sample\tgroup\tsample_type\n"
        "sample1.kraken.report.txt\tGroup 1\tClinical\n",
        encoding="utf-8",
    )
    print(f"Wrote templates to: {outdir}")
    return 0


def command_download_reference(args: argparse.Namespace) -> int:
    out = Path(args.out).expanduser()
    out = (repo_root() / out).resolve() if not out.is_absolute() else out.resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    if out.exists() and not args.force:
        raise SystemExit(f"ERROR: output exists: {out}\nUse --force to overwrite.")
    tmp = out.with_suffix(out.suffix + ".tmp")
    request = urllib.request.Request(args.url, headers={"User-Agent": "Celltaminate"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response, tmp.open("wb") as handle:
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                handle.write(chunk)
        tmp.replace(out)
    except Exception as exc:
        if tmp.exists():
            tmp.unlink()
        raise SystemExit(f"ERROR: reference download failed: {exc}\nReference DOI: {REFERENCE_DOI}")
    print(f"Reference table written to: {out}")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="celltaminate", description="Contamination-aware prioritization from Kraken2 or KrakenUniq reports.")
    p.add_argument("--version", action="version", version=f"Celltaminate {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run", help="Run Celltaminate on taxonomic reports")
    run.add_argument("--reports", nargs="+")
    run.add_argument("--input-list")
    run.add_argument("--metadata")
    run.add_argument("--outdir", required=True)
    run.add_argument("--tax-level", choices=["G", "S"], default="S")
    run.add_argument("--host-species", default="human")
    run.add_argument("--host-taxids-manual", default="")
    add_bool(run, "--include-protozoa", True)
    add_bool(run, "--collapse-species", True)
    run.add_argument("--collapse-min-genus-reads", type=int, default=30)
    run.add_argument("--collapse-top-frac", type=float, default=0.85)
    run.add_argument("--fp-true-cutoff", type=float, default=1)
    run.add_argument("--ref-bg-tsv")
    run.add_argument("--kitome-blacklist-tsv")
    run.add_argument("--clinical-panel-tsv")
    run.add_argument("--protected-taxa-tsv")
    add_bool(run, "--keep-descendants", False)
    add_bool(run, "--show-fp-breakdown", False)
    add_bool(run, "--save-cleaned-reanalysis", True)
    run.add_argument("--rscript", default=os.environ.get("RSCRIPT", "Rscript"))
    run.add_argument("--dry-run", action="store_true")
    run.set_defaults(func=command_run)

    app = sub.add_parser("app", help="Launch the Shiny application")
    app.add_argument("--rscript", default=os.environ.get("RSCRIPT", "Rscript"))
    app.add_argument("--dry-run", action="store_true")
    app.set_defaults(func=command_app)

    init = sub.add_parser("init", help="Write template input files")
    init.add_argument("--outdir", default="celltaminate_template")
    init.set_defaults(func=command_init)

    ref = sub.add_parser("download-reference", help="Download the sterile-reference background table")
    ref.add_argument("--out", default="data/reference/refined_cell.lines.tsv")
    ref.add_argument("--url", default=REFERENCE_URL)
    ref.add_argument("--force", action="store_true")
    ref.set_defaults(func=command_download_reference)
    return p


def main() -> int:
    args = parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
